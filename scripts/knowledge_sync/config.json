    {
      "module": "Dashboard",
      "paths": ["citadel-dashboard/**"],
      "notes": ["06 - Dashboard/Dashboard Overview.md", "06 - Dashboard/Route Registry.md", "06 - Dashboard/Module Visibility Matrix.md"]
    },
    {
      "module": "Backend Architecture",
      "paths": ["app/**", "src/api/**", "src/dashboard/**"],
      "notes": ["01 - System Architecture/Backend Architecture.md", "01 - System Architecture/Data Flow.md"]
    },
    {
      "module": "Operations",
      "paths": ["ops/**", "scripts/run-citadel-*.sh", "scripts/citadel-supervisor.sh", "scripts/watch-citadel-env.sh"],
      "notes": ["11 - Operations/Runbook.md", "11 - Operations/Service Registry.md", "11 - Operations/Restart and Recovery.md"]
    },
    {
      "module": "Shared Infrastructure",
      "paths": ["tests/**", "src/**/*test*.py", "src/timeframe/**", "src/fvg/**"],
      "notes": ["02 - Modules/Shared Infrastructure/Shared Infrastructure Overview.md"]
    }
  ]
}
