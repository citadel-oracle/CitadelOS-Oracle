{
  "schema_version": 1,
  "enabled": true,
  "repository": "/Users/ayushmudgal/Developer/CitadelOS-Worktrees/rc2-backend",
  "vault": "/Users/ayushmudgal/Documents/CITADEL Knowledge Base",
  "mcp_server": "obsidian",
  "test_connection_note": "TEST_CONNECTION.md",
  "max_diff_bytes": 160000,
  "codex_timeout_seconds": 600,
  "ignored_paths": [
    "scripts/knowledge_sync/**",
    "reports/**",
    "scratch/**",
    "**/*.png",
    "**/*.jpg",
    "**/*.jpeg",
    "**/*.gif",
    "**/*.webp",
    "**/*.bundle"
  ],
  "targets": {
    "changelog": "00 - CITADEL HQ/Changelog.md",
    "release_notes": "00 - CITADEL HQ/Release Notes.md",
    "decision_log": "08 - Decisions/Architecture Decision Log.md",
    "incident_register": "09 - Bugs & Incidents/Incident Register.md",
    "validation_folder": "10 - Validation & Proofs"
  },
  "module_rules": [
    {
      "module": "ARGUS",
      "paths": ["src/argus/**", "src/api/argus_api.py", "scripts/run_*argus*.py"],
      "notes": ["02 - Modules/ARGUS/ARGUS Overview.md", "02 - Modules/ARGUS/ARGUS Validation Status.md"]
    },
    {
      "module": "VOB",
      "paths": ["src/vob/**", "citadel-dashboard/src/**/*VOB*"],
      "notes": ["02 - Modules/VOB/VOB Overview.md", "02 - Modules/VOB/VOB Validation Status.md"]
    },
    {
      "module": "OSE",
      "paths": ["src/ose/**", "citadel-dashboard/src/**/*OSE*"],
      "notes": ["02 - Modules/OSE/OSE Overview.md", "02 - Modules/OSE/OSE Validation Status.md"]
    },
    {
      "module": "Backtest Engine",
      "paths": ["src/backtest/**", "scripts/run_*replay.py", "scripts/run_*validation.py"],
      "notes": ["02 - Modules/Backtest Engine/Backtest Engine Overview.md", "04 - Backtests/Backtest Index.md"]
