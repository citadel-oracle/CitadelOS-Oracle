    {
      "module": "Strategies",
      "paths": ["src/strategy_lab/**", "src/strategies/**", "src/strategy_manager.py"],
      "notes": ["03 - Strategies/Strategy Registry.md", "02 - Modules/Backtest Engine/Backtest Engine Overview.md"]
