    {
      "module": "Analyzer",
      "paths": ["src/analyzer/**", "src/**/*openalgo*", "scripts/**/*analy*"],
      "notes": ["02 - Modules/Analyzer/Analyzer Overview.md", "05 - Data & Broker/OpenAlgo Integration.md"]
    },
    {
      "module": "Data & Broker",
      "paths": ["src/broker/**", "src/dhan*", "src/data/**", "config/**"],
      "notes": ["05 - Data & Broker/Data Sources.md", "05 - Data & Broker/Dhan Integration.md"]
    },
    {
      "module": "Execution & Risk",
      "paths": ["src/execution/**", "src/risk/**", "src/trade_manager.py", "src/order*"],
      "notes": ["02 - Modules/Execution & Risk/Execution and Risk Overview.md", "01 - System Architecture/Safety Boundaries.md"]
