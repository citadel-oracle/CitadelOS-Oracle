#!/bin/sh
set -eu

SCRIPT_DIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
REPO=$(git -C "$SCRIPT_DIR/../.." rev-parse --show-toplevel)
HOOKS=$(git -C "$REPO" rev-parse --git-path hooks)
TARGET="$HOOKS/post-commit"
SOURCE="$SCRIPT_DIR/post-commit.hook"
MARKER="Installed only by install-hook"

case "${1:-}" in
  --install)
    if [ -e "$TARGET" ] && ! grep -q "$MARKER" "$TARGET"; then
      echo "Refusing to overwrite existing non-CITADEL post-commit hook: $TARGET" >&2
      exit 1
    fi
    install -m 0755 "$SOURCE" "$TARGET"
    echo "Installed disabled-by-default hook: $TARGET"
    ;;
  --uninstall)
    if [ ! -e "$TARGET" ]; then
      echo "No post-commit hook is installed."
    elif grep -q "$MARKER" "$TARGET"; then
      rm -f "$TARGET"
      echo "Removed CITADEL documentation-sync hook: $TARGET"
    else
      echo "Refusing to remove non-CITADEL post-commit hook: $TARGET" >&2
      exit 1
    fi
    ;;
  *)
    echo "usage: $0 {--install|--uninstall}" >&2
    exit 64
    ;;
esac
